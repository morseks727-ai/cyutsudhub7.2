    -- After the Cloner tool activates, select the game's "Change With Cloner" UI action.
    local function _CyutsudClickChangeWithCloner(timeout)
        local deadline = os.clock() + (tonumber(timeout) or 2.5)
        local function scanRoot(root)
            if not root then return false end
            local ok, descendants = pcall(function() return root:GetDescendants() end)
            if not ok or not descendants then return false end
            for _, obj in ipairs(descendants) do
                if obj:IsA("TextButton") and obj.Visible then
                    local label = string.lower((obj.Text or ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or "")
                    if label:find("change with cloner", 1, true) then
                        local clicked = pcall(function() obj:Activate() end)
                        if clicked then return true end
                    end
                end
            end
            return false
        end
        repeat
            local lp = Players.LocalPlayer
            local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
            if scanRoot(pg) then return true end
            local found = false
            pcall(function()
                if type(gethui) == "function" then found = scanRoot(gethui()) end
            end)
            if found then return true end
            found = false
            pcall(function() found = scanRoot(game:GetService("CoreGui")) end)
            if found then return true end
            task.wait(0.1)
        until os.clock() >= deadline or _isShuttingDown()
        return false
    end

